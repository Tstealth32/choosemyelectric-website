{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/site.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/site.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/estimate.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/compare-electric-rates-by-zip",
      "destination": "/compare-electric-rates-by-zip.html"
    },
    {
      "source": "/estimate",
      "destination": "/estimate.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/pennsylvania-electric-rates",
      "destination": "/pennsylvania-electric-rates.html"
    },
    {
      "source": "/ohio-electric-rates",
      "destination": "/ohio-electric-rates.html"
    },
    {
      "source": "/texas-electricity-plans",
      "destination": "/texas-electricity-plans.html"
    },
    {
      "source": "/pennsylvania/philadelphia-electric-rates",
      "destination": "/pennsylvania/philadelphia-electric-rates.html"
    },
    {
      "source": "/pennsylvania/pittsburgh-electric-rates",
      "destination": "/pennsylvania/pittsburgh-electric-rates.html"
    },
    {
      "source": "/ohio/columbus-electric-rates",
      "destination": "/ohio/columbus-electric-rates.html"
    },
    {
      "source": "/texas/dallas-electricity-rates",
      "destination": "/texas/dallas-electricity-rates.html"
    },
    {
      "source": "/rate-expiration-alerts",
      "destination": "/rate-expiration-alerts.html"
