    {
      "source": "/how-to-switch-electric-suppliers",
      "destination": "/how-to-switch-electric-suppliers.html"
    },
    {
      "source": "/upload-your-bill-to-compare-rates",
      "destination": "/upload-your-bill-to-compare-rates.html"
    },
    {
      "source": "/electricity-supplier-faq",
      "destination": "/electricity-supplier-faq.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/best-electric-suppliers-pennsylvania",
      "destination": "/blog/best-electric-suppliers-pennsylvania.html"
    },
    {
      "source": "/blog/how-to-avoid-early-termination-fees",
